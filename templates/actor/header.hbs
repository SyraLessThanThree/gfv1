<header class="sheet-header">
  <img
    class="profile-img"
    src="{{actor.img}}"
    data-edit="img"
    data-action="editImage"
    title="{{actor.name}}"
  />
  <div class="header-fields">
    <div>
      <label>{{localize (concat "GFv1.actor." actor.type ".name")}}</label>
      {{formInput fields.name value=actor.name disabled=locked}}
    </div>
    {{#if (defined system.pronouns)}}
      <div>
        <label>{{localize "GFv1.actor.pronouns"}}</label>
        {{formInput
          systemFields.pronouns
          value=system.pronouns
          disabled=locked
        }}
      </div>
    {{/if}}
    {{#if (defined system.legalPronouns)}}
      <div>
        <label>{{localize "GFv1.actor.legalPronouns"}}</label>
        {{formInput
          systemFields.legalPronouns
          value=system.legalPronouns
          disabled=locked
        }}
      </div>
    {{/if}}
    {{#if (defined system.preferredPronouns)}}
      <div>
        <label>{{localize "GFv1.actor.preferredPronouns"}}</label>
        {{formInput
          systemFields.preferredPronouns
          value=system.preferredPronouns
          disabled=locked
        }}
      </div>
    {{/if}}
    {{#if (defined system.framePronouns)}}
      <div>
        <label>{{localize "GFv1.actor.framePronouns"}}</label>
        {{formInput
          systemFields.framePronouns
          value=system.framePronouns
          disabled=locked
        }}
      </div>
    {{/if}}
  </div>
</header>